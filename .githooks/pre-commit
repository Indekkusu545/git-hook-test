#!/usr/bin/env bash
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

if git diff --cached -- $staged_files | grep -E '^\+.*(TODO|FIXME)' >/dev/null; then
  echo "pre-commit: Found TODO/FIXME in staged changes. Remove them before committing."
  exit 1
fi

exit 0
